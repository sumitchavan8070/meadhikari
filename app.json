{
  "expo": {
    "name": "Meadhikari - MPSC Preparation",
    "slug": "client",
    "version": "1.0.5",  
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "plugins": [
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ],
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sc.meadhikari",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your app needs access to location services when in use.",
        "NSLocationAlwaysUsageDescription": "Your app needs access to location services even when not in use."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sc.meadhikari",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "versionCode": 4 
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5c77bf90-37b0-4d90-bb57-735bf279d114"
      }
    },
    "runtimeVersion": "1.0.5", 
    "updates": {
      "url": "https://u.expo.dev/5c77bf90-37b0-4d90-bb57-735bf279d114"
    },
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
